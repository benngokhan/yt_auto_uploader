# Template only — replace placeholder values before use.
# Never put real bot tokens or OAuth credentials in this tracked file.
# .env is gitignored.

# Telegram notifications
# Not: gerçek değerleri bu dosyaya yazmayın; sadece örnek/placeholder.
TELEGRAM_BOT_TOKEN=123456:EXAMPLE_TOKEN
# Tek sohbet (kişisel) veya grup için:
TELEGRAM_CHAT_ID=123456789
# Grup sohbeti (kokpit) icin:
# TELEGRAM_GROUP_CHAT_ID=-1000000000000
# Not: tek bot kullaniliyor (@Bilgindozlu_bot). Ayri botlar kaldirildi.

# Google Drive queue folder ID (also add as GitHub Actions Secret)
DRIVE_QUEUE_FOLDER_ID=1

# Google OAuth JSON credentials are supplied as GitHub Actions Secrets:
# GOOGLE_CLIENT_SECRETS_JSON=1
# GOOGLE_TOKEN_JSON=1

# Optional AI providers
GROQ_API_KEY=1
GEMINI_API_KEY=1
