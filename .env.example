# Template only — replace placeholder values before use.
# Never put real tokens in this tracked file. .env is gitignored.

# Telegram notifications (also add as GitHub Actions Secrets)
TELEGRAM_BOT_TOKEN=1
TELEGRAM_CHAT_ID=1

# Google Drive queue folder ID (also add as GitHub Actions Secret)
DRIVE_QUEUE_FOLDER_ID=1

# Google OAuth JSON credentials are supplied as GitHub Actions Secrets:
# GOOGLE_CLIENT_SECRETS_JSON=1
# GOOGLE_TOKEN_JSON=1

# Groq API key (optional)
GROQ_API_KEY=1

# Gemini API key (optional)
GEMINI_API_KEY=1
